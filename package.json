{
  "name": "docs",
  "type": "module",
  "private": true,
  "scripts": {
    "genapi": "node ./scripts/generate-docs.js",
    "prebuild": "npm run genapi",
    "build": "next build",
    "dev": "rm -rf .next && next dev --turbopack --port 7575",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "prepare": "husky && npm run genapi"
  },
  "dependencies": {
    "fumadocs-core": "^15.0.3",
    "fumadocs-mdx": "^11.5.1",
    "fumadocs-openapi": "^6.0.4",
    "fumadocs-ui": "^15.0.3",
    "geist": "^1.3.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@tailwindcss/postcss": "^4.0.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "commitlint-config-non-conventional": "^1.0.1",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.7.3"
