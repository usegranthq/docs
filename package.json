{
  "name": "docs",
  "type": "module",
  "private": true,
  "scripts": {
    "genapi": "node ./scripts/generate-docs.js",
    "prebuild": "npm run genapi",
    "build": "next build",
    "dev": "rm -rf .next && next dev --turbopack --port 7575",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "prepare": "husky && npm run genapi"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "fumadocs-core": "^15.4.0",
    "fumadocs-mdx": "^11.6.6",
    "fumadocs-openapi": "^9.0.0",
    "fumadocs-ui": "^15.4.0",
    "geist": "^1.4.2",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "commitlint-config-non-conventional": "^1.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "oxlint": "^0.16.12",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
